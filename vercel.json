    {
      "source": "/seo-services",
      "destination": "/blog/seo-services",
      "permanent": true
    },
    {
      "source": "/social-media-marketing",
      "destination": "/blog/social-media-marketing",
      "permanent": true
    },
    {
      "source": "/website-optimization",
      "destination": "/blog/website-optimization",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
